{
  "functions": {
    "api/router.php": {
      "runtime": "vercel-php@0.7.4",
      "includeFiles": "{index,login,register,logout,layanan,transaksi,laporan,struk,profil,erd}.php,{config,includes,actions,database,assets}/**"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/router.php"
    }
  ]
}
